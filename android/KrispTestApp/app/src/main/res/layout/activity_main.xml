<?xml version="1.0" encoding="utf-8"?>
<!-- File Processing page, laid out like the iOS app's FileProcessingView. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".WavProcessActivity">

    <!-- gravity center: fillViewport stretches this to the screen height, so the content sits in the middle when it
         fits, and scrolls when it doesn't. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Krisp icon + app name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/image_krisp_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/krisp_icon" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txt_header"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_sdk_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            tools:text="Krisp SDK Version: 9.22.0.0" />

        <TextView
            android:id="@+id/text_page_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/txt_page_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Load WAV -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_wav_file"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_wav_name"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/status_wav"
                style="@style/StatusMark"
                android:text="@string/status_fail" />
        </LinearLayout>

        <!-- Select model -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_model_file"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_model_name"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/status_model"
                style="@style/StatusMark"
                android:text="@string/status_fail" />
        </LinearLayout>

        <!-- NcSessionConfig::enableLowPrecisionExecution of the next run. Offset like the buttons, so it lines up
             under them rather than centered over the button + status-mark rows. -->
        <CheckBox
            android:id="@+id/checkbox_low_precision"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="52dp"
            android:text="@string/chk_low_precision" />

        <!-- Process / Stop -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_process"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_process_name"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/status_process"
                style="@style/StatusMark"
                android:text="@string/status_fail" />
        </LinearLayout>

        <!-- Loaded files -->
        <TextView
            android:id="@+id/text_wav_file"
            style="@style/InfoLine"
            android:layout_marginTop="16dp"
            android:text="@string/txt_wav" />

        <TextView
            android:id="@+id/text_model_file"
            style="@style/InfoLine"
            android:text="@string/txt_model" />

        <TextView
            android:id="@+id/text_process_status"
            style="@style/InfoLine"
            android:layout_marginTop="8dp"
            android:text="@string/txt_process"
            android:textStyle="bold" />

        <!-- Processing stats -->
        <TextView
            android:id="@+id/text_frames"
            style="@style/InfoLine"
            android:layout_marginTop="8dp"
            tools:text="Audio frames processed: 2000 / 4000" />

        <TextView
            android:id="@+id/text_audio_duration"
            style="@style/InfoLine"
            tools:text="Audio processed: 60.0 s (32000 Hz, 30 ms frames)" />

        <TextView
            android:id="@+id/text_processing_time"
            style="@style/InfoLine"
            tools:text="Processing time: 1.23 s NC · 1.40 s total" />

        <TextView
            android:id="@+id/text_speed"
            style="@style/InfoLine"
            tools:text="Speed: 48.8x realtime · 0.615 ms per frame" />

        <TextView
            android:id="@+id/text_precision"
            style="@style/InfoLine"
            tools:text="Low precision: on · CPU FP16: yes" />

        <!-- Save -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_save"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_save_name"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/status_save"
                style="@style/StatusMark"
                android:text="@string/status_fail" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
